<launch>
  <arg name="rviz" default="true" />
  <arg name="config" default="$(find voxel_slam)/config/localization_mid360.yaml" />
  <arg name="map_path" default="" />

  <rosparam command="load" file="$(arg config)" />
  <param name="General/mode" value="localization" />
  <param name="General/map_export_path" value="" />
  <param if="$(eval arg('map_path') != '')"
         name="Localization/map_path" value="$(arg map_path)" />
  <param name="finish" value="false" />

  <node pkg="voxel_slam" type="voxelslam" name="voxelslam"
        output="screen" />

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find voxel_slam)/rviz_cfg/back.rviz" />
  </group>
</launch>
